{
  "name": "bull-rush",
  "description": "BULL RUSH — a 3D neon endless runner for The Black Bull ($ANSEM).",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "sync-sim": "node scripts/sync-sim.mjs",
    "local:db": "docker compose up -d",
    "local:db:down": "docker compose down",
    "local:api": "cd server && node --env-file=.env --import tsx src/index.ts",
    "local:verify": "npx tsx scripts/verify-local.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "howler": "^2.2.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.182.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^5.0.0",
    "terser": "^5.39.0",
    "typescript": "~5.7.2",
    "vite": "^6.3.1"
  }
}
